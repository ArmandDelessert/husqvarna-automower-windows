<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HusqaCockpit.App.Views.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HusqaCockpit.App.Views"
    NavigationCacheMode="Required">

    <Grid Padding="32,16,32,32" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Map_Title" VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" />
            <Button x:Uid="Map_Recenter" Grid.Column="1" Click="Recenter_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE81D;" />
                    <TextBlock x:Uid="Map_RecenterText" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- One card per mower: the bar is the color of its track on the map, the icon says what it is doing.
             A click opens the details of the mower. -->
        <ItemsRepeater x:Name="Legend" Grid.Row="1">
            <ItemsRepeater.Layout>
                <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="12" MinItemWidth="300" MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:LegendItem">
                    <Button
                        x:Uid="Card_Details"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Click="OpenDetails_Click"
                        Tag="{x:Bind Mower.Id}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="6" Background="{x:Bind TrackBrush}" CornerRadius="3,0,0,3" />
                            <StackPanel Grid.Column="1" Padding="0,8" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Mower.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{x:Bind local:BindingHelpers.SeverityBrush(Mower.Severity), Mode=OneWay}"
                                        Glyph="{x:Bind Mower.StatusGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Mower.StatusTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Style="{StaticResource CaptionSecondaryStyle}"
                                    Text="{x:Bind local:BindingHelpers.DetailWhenConnected(Mower.IsConnected, Mower.StatusDetail), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind local:BindingHelpers.VisibleWhenConnectedAndNotEmpty(Mower.IsConnected, Mower.StatusDetail), Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource CaptionSecondaryStyle}"
                                    Text="{x:Bind Mower.LastSeenText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind local:BindingHelpers.VisibleWhenNotEmpty(Mower.LastSeenText), Mode=OneWay}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <local:MapView x:Name="Map" />
                <TextBlock
                    x:Name="EmptyText"
                    x:Uid="Map_Empty"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
