<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HusqaCockpit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HusqaCockpit.App.Views">

    <ScrollViewer x:Name="Scroller" Padding="32,16,32,32">
        <StackPanel x:Name="Sections" MaxWidth="860" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Notifications -->
            <TextBlock x:Uid="Settings_NotificationsHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Uid="Settings_NotifyErrors" IsOn="{x:Bind ViewModel.NotifyErrors, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_NotifyRecoveries" IsOn="{x:Bind ViewModel.NotifyRecoveries, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_NotifyStopped" IsOn="{x:Bind ViewModel.NotifyStopped, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_NotifyConnectivity" IsOn="{x:Bind ViewModel.NotifyConnectivity, Mode=TwoWay}" />
                    <ComboBox
                        x:Uid="Settings_TaskNotifications"
                        Margin="0,8,0,0"
                        MinWidth="220"
                        ItemsSource="{x:Bind ViewModel.TaskNotificationNames}"
                        SelectedIndex="{x:Bind ViewModel.TaskNotificationsIndex, Mode=TwoWay}" />
                    <Button x:Uid="Settings_TestNotification" Margin="0,8,0,0" Command="{x:Bind ViewModel.SendTestNotificationCommand}" />
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <TextBlock x:Uid="Settings_BehaviorHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Uid="Settings_CloseToTray" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch x:Uid="Settings_StartWithWindows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ComboBox
                        x:Uid="Settings_PollingInterval"
                        MinWidth="220"
                        ItemsSource="{x:Bind ViewModel.PollingIntervalNames}"
                        SelectedIndex="{x:Bind ViewModel.PollingIntervalIndex, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.PollingHelpText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Language -->
            <TextBlock x:Uid="Settings_LanguageHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ComboBox x:Uid="Settings_Language" MinWidth="220" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="Settings_LanguageSystem" />
                        <ComboBoxItem Content="Français" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                    <InfoBar
                        x:Uid="Settings_RestartRequired"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="Settings_RestartNow" Command="{x:Bind ViewModel.RestartCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Husqvarna API: the key, and how much of the monthly quota this computer used -->
            <TextBlock x:Name="ApiHeader" x:Uid="Settings_ApiHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_ApiHelp" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <HyperlinkButton x:Uid="Settings_ApiPortal" Padding="0" NavigateUri="https://developer.husqvarnagroup.cloud/applications" />
                    <TextBox x:Uid="Settings_ApplicationKey" Text="{x:Bind ViewModel.ApplicationKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox x:Uid="Settings_ApplicationSecret" Password="{x:Bind ViewModel.ApplicationSecret, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_Save" Command="{x:Bind ViewModel.SaveCredentialsCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Uid="Settings_Test" Command="{x:Bind ViewModel.TestCredentialsCommand}" />
                        <Button
                            x:Uid="Settings_Delete"
                            Command="{x:Bind ViewModel.DeleteCredentialsCommand}"
                            Visibility="{x:Bind ViewModel.HasStoredCredentials, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.TestCredentialsCommand.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsCredentialResultVisible, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.CredentialResult, Mode=OneWay}"
                        Severity="{x:Bind local:BindingHelpers.InfoBarSeverityFor(ViewModel.CredentialResultSeverity), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock x:Uid="Settings_ApiStorage" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock x:Uid="Settings_AboutHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock x:Uid="Settings_Disclaimer" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Uid="Settings_SourceCode" NavigateUri="https://github.com/ArmandDelessert/husqvarna-automower-windows" />
                        <HyperlinkButton x:Uid="Settings_OpenLogs" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
