<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The app's own texts: the tests check what the user reads, and that no key is missing. -->
    <None Include="..\..\src\HusqaCockpit.App\Strings\**\*.resw" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Settings page, whose structure is checked against the twin application's. -->
    <None Include="..\..\src\HusqaCockpit.App\Views\SettingsPage.xaml" Link="Views\SettingsPage.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HusqaCockpit.Presentation\HusqaCockpit.Presentation.csproj" />
  </ItemGroup>

</Project>
